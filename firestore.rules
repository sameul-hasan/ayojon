rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------

    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        getUserData().platform_role == 'ADMIN'
      );
    }

    function isOrganizer() {
      return isAuthenticated() && (
        request.auth.token.role == 'organizer' ||
        getUserData().platform_role == 'ORGANIZER_OWNER' ||
        getUserData().platform_role == 'EVENT_MANAGER'
      );
    }

    function isStaff() {
      return isAuthenticated() && (
        request.auth.token.role == 'staff' ||
        getUserData().platform_role == 'CHECKIN_STAFF'
      );
    }

    function isSponsor() {
      return isAuthenticated() && (
        request.auth.token.role == 'sponsor' ||
        getUserData().platform_role == 'SPONSOR'
      );
    }

    function isVenueOwner() {
      return isAuthenticated() && (
        request.auth.token.role == 'venue_owner' ||
        getUserData().platform_role == 'VENUE_OWNER'
      );
    }

    function isVendor() {
      return isAuthenticated() && (
        request.auth.token.role == 'vendor' ||
        getUserData().platform_role == 'VENDOR'
      );
    }

    function isNotSuspended() {
      return !isAuthenticated() || getUserData().status != 'SUSPENDED';
    }

    // -------------------------------------------------------------------------
    // 1. Profiles Collection (RBAC & Self-Escalation Protection)
    // -------------------------------------------------------------------------
    match /profiles/{userId} {
      // Anyone authenticated can read user display names and public avatars
      allow read: if isAuthenticated();

      // Users can only update their own profile; CANNOT modify role, platform_role, or verification status
      allow update: if isUser(userId)
                    && isNotSuspended()
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'platform_role', 'status', 'verification_status'])
                    || isAdmin();

      // Only Admin or trusted server auth triggers can create or assign initial roles
      allow create: if isUser(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // 2. Organizations & Memberships
    // -------------------------------------------------------------------------
    match /organizations/{orgId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /organization_members/{memberId} {
      allow read: if isAuthenticated() && (
        resource.data.user_id == request.auth.uid ||
        isAdmin()
      );
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // 3. Events Collection (Ownership & Moderation)
    // -------------------------------------------------------------------------
    match /events/{eventId} {
      // Public events can be read by anyone; Draft or Suspended events only by owner or admin
      allow read: if resource.data.status == 'PUBLISHED'
                  || (isAuthenticated() && resource.data.organizer_user_id == request.auth.uid)
                  || isAdmin();

      // Creation requires Organizer or Admin role
      allow create: if (isOrganizer() || isAdmin()) && isNotSuspended();

      // Update / Delete requires Event Organizer ownership or Admin
      allow update, delete: if (
        (isAuthenticated() && resource.data.organizer_user_id == request.auth.uid && isNotSuspended())
        || isAdmin()
      );
    }

    // -------------------------------------------------------------------------
    // 4. Ticket Types & Registrations
    // -------------------------------------------------------------------------
    match /ticket_types/{ticketTypeId} {
      allow read: if true;
      allow write: if (isOrganizer() || isAdmin()) && isNotSuspended();
    }

    match /registrations/{regId} {
      // Attendees read own registrations; Organizers read registrations for their events; Staff inspects for checkin
      allow read: if isAuthenticated() && (
        resource.data.user_id == request.auth.uid ||
        resource.data.organizer_user_id == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated() && isNotSuspended();
      allow update: if (isOrganizer() || isAdmin()) && isNotSuspended();
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // 5. Orders & Financial Transactions
    // -------------------------------------------------------------------------
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (
        resource.data.user_id == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated() && isNotSuspended();
      // Only server webhook or admin can update order status (PAID/FAILED)
      allow update, delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // 6. Tickets & Digital Wallet Passes
    // -------------------------------------------------------------------------
    match /tickets/{ticketId} {
      // Attendees read own tickets; Assigned event staff & organizers can validate
      allow read: if isAuthenticated() && (
        resource.data.buyer_user_id == request.auth.uid ||
        resource.data.attendee_user_id == request.auth.uid ||
        isStaff() ||
        isOrganizer() ||
        isAdmin()
      );
      // Tickets are created exclusively via verified server webhook payment confirmation
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // 7. Check-In Scans (Event Staff Only)
    // -------------------------------------------------------------------------
    match /check_ins/{checkInId} {
      allow read: if isAuthenticated() && (
        resource.data.staff_user_id == request.auth.uid ||
        isOrganizer() ||
        isAdmin()
      );
      allow create: if (isStaff() || isOrganizer() || isAdmin()) && isNotSuspended();
      allow update, delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // 8. Sponsor Inquiries & Proposals
    // -------------------------------------------------------------------------
    match /sponsor_inquiries/{inquiryId} {
      // Sponsor can read own inquiry; Organizer of target event can read; Admin can read
      allow read: if isAuthenticated() && (
        resource.data.sponsor_user_id == request.auth.uid ||
        resource.data.organizer_user_id == request.auth.uid ||
        isAdmin()
      );
      allow create: if (isSponsor() || isAdmin()) && isNotSuspended();
      allow update: if isAuthenticated() && (
        resource.data.sponsor_user_id == request.auth.uid ||
        resource.data.organizer_user_id == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // 9. Venue & Services Marketplace (RFQs, Quotations & Bookings)
    // -------------------------------------------------------------------------
    match /venue_profiles/{venueId} {
      allow read: if true;
      allow create, update: if (isVenueOwner() || isAdmin()) && isNotSuspended();
      allow delete: if isAdmin();
    }

    match /vendor_services/{serviceId} {
      allow read: if true;
      allow create, update: if (isVendor() || isAdmin()) && isNotSuspended();
      allow delete: if isAdmin();
    }

    match /venue_requests/{rfqId} {
      // Only creating organizer and targeted providers can view RFQ; competitors blocked
      allow read: if isAuthenticated() && (
        resource.data.organizer_user_id == request.auth.uid ||
        resource.data.target_provider_ids.hasAny([request.auth.uid]) ||
        isAdmin()
      );
      allow create: if (isOrganizer() || isAdmin()) && isNotSuspended();
      allow update: if (
        (isAuthenticated() && resource.data.organizer_user_id == request.auth.uid) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /quotations/{quotationId} {
      // Strictly private: Only provider author and recipient organizer can read; Competitors blocked!
      allow read: if isAuthenticated() && (
        resource.data.provider_user_id == request.auth.uid ||
        resource.data.organizer_user_id == request.auth.uid ||
        isAdmin()
      );
      allow create: if (isVenueOwner() || isVendor() || isAdmin()) && isNotSuspended();
      allow update: if (
        (isAuthenticated() && resource.data.provider_user_id == request.auth.uid && isNotSuspended()) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /rfq_messages/{messageId} {
      // Thread participants only
      allow read: if isAuthenticated() && (
        resource.data.sender_user_id == request.auth.uid ||
        resource.data.recipient_user_id == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated() && isNotSuspended();
      allow update, delete: if isAdmin();
    }

    match /venue_bookings/{bookingId} {
      // Contracting parties only
      allow read: if isAuthenticated() && (
        resource.data.organizer_user_id == request.auth.uid ||
        resource.data.provider_user_id == request.auth.uid ||
        isAdmin()
      );
      allow create, update: if isAuthenticated() && isNotSuspended();
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // 10. Immutable Security Audit Trail & Platform Reports
    // -------------------------------------------------------------------------
    match /audit_logs/{logId} {
      // Read-only for Admin; no client write allowed (written strictly by server audit engine)
      allow read: if isAdmin();
      allow write: if false;
    }

    match /reports/{reportId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAdmin();
    }
  }
}

