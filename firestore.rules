rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------

    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasProfile() {
      return isAuthenticated() && exists(/databases/$(database)/documents/profiles/$(request.auth.uid));
    }

    function getUserData() {
      return hasProfile() ? get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data : {};
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'super_admin' ||
        getUserData().platform_role == 'ADMIN' ||
        getUserData().platform_role == 'SUPER_ADMIN' ||
        request.auth.token.email == 'superadmin@ayojon.select' ||
        request.auth.token.email == 'superadmin@aayojon.bd' ||
        request.auth.token.email == 'admin@ayojon.select' ||
        request.auth.token.email == 'admin@aayojon.bd' ||
        request.auth.token.email == 'bfos.info@gmail.com'
      );
    }

    function isOrganizer() {
      return isAuthenticated() && (
        request.auth.token.role == 'organizer' ||
        getUserData().platform_role == 'ORGANIZER_OWNER' ||
        getUserData().platform_role == 'EVENT_MANAGER'
      );
    }

    function isStaff() {
      return isAuthenticated() && (
        request.auth.token.role == 'staff' ||
        getUserData().platform_role == 'CHECKIN_STAFF'
      );
    }

    function isSponsor() {
      return isAuthenticated() && (
        request.auth.token.role == 'sponsor' ||
        getUserData().platform_role == 'SPONSOR'
      );
    }

    function isVenueOwner() {
      return isAuthenticated() && (
        request.auth.token.role == 'venue_owner' ||
        getUserData().platform_role == 'VENUE_OWNER'
      );
    }

    function isVendor() {
      return isAuthenticated() && (
        request.auth.token.role == 'vendor' ||
        getUserData().platform_role == 'VENDOR'
      );
    }

    function isNotSuspended() {
      return !hasProfile() || getUserData().status != 'SUSPENDED';
    }

    // -------------------------------------------------------------------------
    // 1. Profiles Collection (Live User Profiles & Synced Auth)
    // -------------------------------------------------------------------------
    match /profiles/{userId} {
      // Anyone can read profiles (needed for display names, avatars on events and comments)
      allow read: if true;

      // Users can create and update their own profile; Admins have full access
      allow create, update: if (isUser(userId) || isAdmin()) && isNotSuspended();
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // 2. Organizations & Memberships
    // -------------------------------------------------------------------------
    match /organizations/{orgId} {
      allow read: if true;
      allow write: if isAuthenticated() && isNotSuspended();
    }

    match /organization_members/{memberId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isNotSuspended();
    }

    // -------------------------------------------------------------------------
    // 3. Events Collection (Public Discovery & Dynamic DB Access)
    // -------------------------------------------------------------------------
    match /events/{eventId} {
      // Public events can be read by anyone (enables public discovery and home page)
      allow read: if true;

      // Creation & updates allowed by authenticated organizers, creators, or admins
      allow create, update: if isAuthenticated() && isNotSuspended();
      allow delete: if (
        (isAuthenticated() && resource.data.organizer_user_id == request.auth.uid) ||
        isAdmin()
      );
    }

    // -------------------------------------------------------------------------
    // 4. Ticket Types, Categories & Venues (Public Catalogs)
    // -------------------------------------------------------------------------
    match /ticket_types/{ticketTypeId} {
      allow read: if true;
      allow write: if isAuthenticated() && isNotSuspended();
    }

    match /categories/{catId} {
      allow read: if true;
      allow write: if isAuthenticated() && isNotSuspended();
    }

    match /venues/{venueId} {
      allow read: if true;
      allow write: if isAuthenticated() && isNotSuspended();
    }

    // -------------------------------------------------------------------------
    // 5. Registrations & Orders (Financial & Ticketing)
    // -------------------------------------------------------------------------
    match /registrations/{regId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isNotSuspended();
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isNotSuspended();
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // 6. Tickets & Digital Wallet Passes
    // -------------------------------------------------------------------------
    match /tickets/{ticketId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isNotSuspended();
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // 7. Check-In Scans (Event Staff Only)
    // -------------------------------------------------------------------------
    match /check_ins/{checkInId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isNotSuspended();
      allow update, delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // 8. Sponsor Inquiries & Proposals
    // -------------------------------------------------------------------------
    match /sponsor_inquiries/{inquiryId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isNotSuspended();
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // 9. Venue & Services Marketplace (RFQs, Quotations & Bookings)
    // -------------------------------------------------------------------------
    match /venue_profiles/{venueId} {
      allow read: if true;
      allow create, update: if isAuthenticated() && isNotSuspended();
      allow delete: if isAdmin();
    }

    match /vendor_services/{serviceId} {
      allow read: if true;
      allow create, update: if isAuthenticated() && isNotSuspended();
      allow delete: if isAdmin();
    }

    match /venue_requests/{rfqId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isNotSuspended();
      allow delete: if isAdmin();
    }

    match /quotations/{quotationId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isNotSuspended();
      allow delete: if isAdmin();
    }

    match /rfq_messages/{messageId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isNotSuspended();
      allow update, delete: if isAdmin();
    }

    match /venue_bookings/{bookingId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isNotSuspended();
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // 10. Audit Trail & Reports
    // -------------------------------------------------------------------------
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /reports/{reportId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAdmin();
    }
  }
}
