# ==============================================================================
# Aayojon Platform — Firebase & Environment Configuration
# ==============================================================================
# Copy this file to `.env` or `.env.local` and replace the placeholder values
# with your actual project credentials from the Firebase Console:
# https://console.firebase.google.com/
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Firebase Web App Configuration (Required for Real Firebase Auth & Firestore)
# ------------------------------------------------------------------------------
# In Firebase Console: Project Settings > General > Your apps > Web app (SDK setup and configuration)
VITE_FIREBASE_API_KEY=AIzaSyA1234567890abcdef-EXAMPLE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project
VITE_FIREBASE_STORAGE_BUCKET=your-firebase-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef
VITE_FIREBASE_MEASUREMENT_ID=G-ABCDEF1234

# ------------------------------------------------------------------------------
# 2. Local Firebase Emulator (Optional — for local offline testing)
# ------------------------------------------------------------------------------
# Set to true to connect to local emulator suite:
VITE_USE_FIREBASE_EMULATOR=false
VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# ------------------------------------------------------------------------------
# 3. Application Port (Optional)
# ------------------------------------------------------------------------------
PORT=5001

